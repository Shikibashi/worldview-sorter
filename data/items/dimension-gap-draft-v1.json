  "items": [
    {
      "id": "PLI126",
      "revision": 1,
      "domainId": "PL",
      "text": "Which division of authority should normally govern a country with national and regional governments?",
      "responseType": "single_choice",
      "responseScaleId": "single_choice",
      "status": "candidate",
      "contentKind": "contrast",
      "targets": [
        {
          "constructId": "PL34",
          "relation": "diagnostic",
          "role": "primary"
        }
      ],
      "options": [
        {
          "id": "entrenched",
          "label": "Each level should have some powers that the other cannot take away unilaterally."
        },
        {
          "id": "national_delegation",
          "label": "The national government may delegate regional powers and reclaim them when appropriate."
        },
        {
          "id": "regional_delegation",
          "label": "Regional governments should be able to reclaim any powers given to the national government."
        },
        {
          "id": "case_by_case",
          "label": "The right arrangement depends on the issue and the country."
        }
      ],
      "draftAnswerMeanings": {
        "entrenched": "supports",
        "national_delegation": "opposes",
        "regional_delegation": "neighbor",
        "case_by_case": "context"
      },
      "mirrorGroup": null,
      "scenarioGroup": null,
      "eligibility": {
        "mode": "always"
      },
      "specialStates": [
        "no_view",
        "not_understood"
      ],
      "contentTags": [
        "dimension_gap",
        "unreleased"
      ],
      "provenance": {
        "origin": "original_project_draft",
        "sourceRefs": [
          "dimension-federalism"
        ],
        "license": {
          "status": "undecided",
          "spdx": null
        },
        "copiedText": false
      },
      "notes": "Distinguishes a federal division from revocable national delegation and a confederation. Generic local preference does not suffice."
    },
    {
      "id": "PLI127",
      "revision": 1,
      "domainId": "PL",
      "text": "A national government wants one uniform policy on a matter assigned by the constitution to regional governments. The regional policy protects rights equally well. What should settle the conflict?",
      "responseType": "single_choice",
      "responseScaleId": "single_choice",
      "status": "candidate",
      "contentKind": "contrast",
      "targets": [
        {
          "constructId": "PL34",
          "relation": "diagnostic",
          "role": "primary"
        }
      ],
      "options": [
        {
          "id": "respect_division",
          "label": "The protected regional authority should stand unless the constitution is properly changed."
        },
        {
          "id": "national_override",
          "label": "The national government should be able to override the region for uniformity."
        },
        {
          "id": "regional_veto",
          "label": "Regional governments should control even matters assigned nationally."
        },
        {
          "id": "other_reason",
          "label": "Other features of the case would determine my view."
        }
      ],
      "draftAnswerMeanings": {
        "respect_division": "supports",
        "national_override": "opposes",
        "regional_veto": "neighbor",
        "other_reason": "context"
      },
      "mirrorGroup": null,
      "scenarioGroup": null,
      "eligibility": {
        "mode": "always"
      },
      "specialStates": [
        "no_view",
        "not_understood"
      ],
      "contentTags": [
        "dimension_gap",
        "unreleased"
      ],
      "provenance": {
        "origin": "original_project_draft",
        "sourceRefs": [
          "dimension-federalism"
        ],
        "license": {
          "status": "undecided",
          "spdx": null
        },
        "copiedText": false
      },
      "notes": "Holds rights protection constant; checks whether decentralization is constitutionally protected rather than merely useful."
    },
    {
      "id": "SOI108",
      "revision": 1,
      "domainId": "SO",
      "text": "A public agency can offer a service in a minority language without reducing service to others. What should it normally do?",
      "responseType": "single_choice",
      "responseScaleId": "single_choice",
      "status": "candidate",
      "contentKind": "contrast",
      "targets": [
        {
          "constructId": "SO16",
          "relation": "diagnostic",
          "role": "primary"
        }
      ],
      "options": [
        {
          "id": "provide",
          "label": "Offer the service in that language."
        },
        {
          "id": "private_only",
          "label": "Allow private use of the language but keep public service in the common language."
        },
        {
          "id": "require_common",
          "label": "Require everyone to use the common language in public services."
        },
        {
          "id": "depends",
          "label": "It depends on further circumstances, such as the cost or demand."
        }
      ],
      "draftAnswerMeanings": {
        "provide": "supports",
        "private_only": "neighbor",
        "require_common": "opposes",
        "depends": "context"
      },
      "mirrorGroup": null,
      "scenarioGroup": null,
      "eligibility": {
        "mode": "always"
      },
      "specialStates": [
        "no_view",
        "not_understood"
      ],
      "contentTags": [
        "dimension_gap",
        "unreleased"
      ],
      "provenance": {
        "origin": "original_project_draft",
        "sourceRefs": [
          "dimension-multiculturalism"
        ],
        "license": {
          "status": "undecided",
          "spdx": null
        },
        "copiedText": false
      },
      "notes": "Tests institutional accommodation rather than mere tolerance. Feasibility is stipulated, but a single scenario does not establish a general view."
    },
    {
      "id": "SOI109",
      "revision": 1,
      "domainId": "SO",
      "text": "A generally useful public rule burdens a harmless cultural practice unusually heavily. Which response is preferable?",
      "responseType": "single_choice",
      "responseScaleId": "single_choice",
      "status": "candidate",
      "contentKind": "contrast",
      "targets": [
        {
          "constructId": "SO16",
          "relation": "diagnostic",
          "role": "primary"
        }
      ],
      "options": [
        {
          "id": "reasonable_exception",
          "label": "Allow a reasonable exception while preserving the rule for others."
        },
        {
          "id": "same_rule",
          "label": "Apply the rule identically despite the unequal burden."
        },
        {
          "id": "private_tolerance",
          "label": "Permit the practice in private but make no public exception."
        },
        {
          "id": "depends",
          "label": "The answer depends on the rule and burden involved."
        }
      ],
      "draftAnswerMeanings": {
        "reasonable_exception": "supports",
        "same_rule": "opposes",
        "private_tolerance": "neighbor",
        "depends": "context"
      },
      "mirrorGroup": null,
      "scenarioGroup": null,
      "eligibility": {
        "mode": "always"
      },
      "specialStates": [
        "no_view",
        "not_understood"
      ],
      "contentTags": [
        "dimension_gap",
        "unreleased"
      ],
      "provenance": {
        "origin": "original_project_draft",
        "sourceRefs": [
          "dimension-multiculturalism"
        ],
        "license": {
          "status": "undecided",
          "spdx": null
        },
        "copiedText": false
      },
      "notes": "Separates accommodation from formal uniformity; harmless does not mean every exception is costless."
    },
    {
      "id": "PLI128",
      "revision": 1,
      "domainId": "PL",
      "text": "Should a peaceful person normally have a moral claim to settle in another country when no specific threat from that person is shown?",
      "responseType": "single_choice",
      "responseScaleId": "single_choice",
      "status": "candidate",
      "contentKind": "contrast",
      "targets": [
        {
          "constructId": "PL35",
          "relation": "diagnostic",
          "role": "primary"
        }
      ],
      "options": [
        {
          "id": "presumption",
          "label": "Yes, with restrictions requiring a further justification."
        },
        {
          "id": "broad_discretion",
          "label": "No, the receiving state may exclude people for broad collective aims."
        },
        {
          "id": "legal_only",
          "label": "Only if the receiving state already grants permission."
        },
        {
          "id": "depends",
          "label": "It depends on further features of the case."
        }
      ],
      "draftAnswerMeanings": {
        "presumption": "supports",
        "broad_discretion": "opposes",
        "legal_only": "neighbor",
        "depends": "context"
      },
      "mirrorGroup": null,
      "scenarioGroup": null,
      "eligibility": {
        "mode": "always"
      },
      "specialStates": [
        "no_view",
        "not_understood"
      ],
      "contentTags": [
        "dimension_gap",
        "unreleased"
      ],
      "provenance": {
        "origin": "original_project_draft",
        "sourceRefs": [
          "dimension-immigration"
        ],
        "license": {
          "status": "undecided",
          "spdx": null
        },
        "copiedText": false
      },
      "notes": "A moral presumption is distinct from a claim that borders must always be open."
    },
    {
