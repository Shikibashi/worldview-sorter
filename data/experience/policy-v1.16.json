  "sources": [
    {
      "id": "ux-sailer-2017",
      "title": "Sailer, Hense, Mayr & Mandl (2017): How gamification motivates",
      "url": "https://doi.org/10.1016/j.chb.2016.12.033",
      "reviewedUrl": "https://www.researchgate.net/publication/311879391_How_gamification_motivates_An_experimental_study_of_the_effects_of_specific_game_design_elements_on_psychological_need_satisfaction",
      "access": "author-uploaded article text, abstract and discussion reviewed",
      "locator": "Abstract; sections 6.4–7",
      "kind": "randomized_experiment",
      "finding": "Different configurations of game elements affected different reported needs; perceived decision freedom was not changed as intended.",
      "designInference": "Treat game elements individually and do not promise that points make a worldview questionnaire fun or valid.",
      "validatesThisQuiz": false
    },
    {
      "id": "ux-polzler-2018",
      "title": "Pölzler (2018): How to Measure Moral Realism",
      "url": "https://doi.org/10.1007/s13164-018-0401-8",
      "reviewedUrl": "https://link.springer.com/article/10.1007/s13164-018-0401-8",
      "access": "full HTML available; abstract and sections 1–7 reviewed",
      "locator": "G1–G5; introduction",
      "kind": "peer_reviewed_methodological_analysis",
      "finding": "Related philosophical positions, incomplete answer choices and first-order moral prompts can undermine intended construct measurement.",
      "designInference": "Preserve question wording and distinctions; avoid ideology targets or congratulating particular answers while answering.",
      "validatesThisQuiz": false
    },
    {
      "id": "ux-wcag-targets",
      "title": "W3C: Understanding Target Size (Minimum)",
      "url": "https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html",
      "access": "official guidance reviewed",
      "kind": "accessibility_guidance_not_psychometric_evidence",
      "designInference": "Large controls, adequate spacing, keyboard access and no drag-only rankings."
    },
    {
      "id": "ux-wcag-motion",
      "title": "W3C: Understanding Animation from Interactions",
      "url": "https://www.w3.org/WAI/WCAG22/Understanding/animation-from-interactions.html",
      "access": "official guidance reviewed",
      "kind": "accessibility_guidance_not_psychometric_evidence",
      "designInference": "Respect reduced-motion preferences and do not require animation or sound."
    }
  ],
  "reviewedOn": "2026-09-29",
