{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shikibashi/worldview-sorter/schemas/successor-release-plan.schema.json",
  "title": "Worldview Sorter Successor Release Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "builder",
    "authoredInputs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "successor-release-plan-1"
    },
    "version": {
      "type": "string",
      "pattern": "^model-release-\\d+\\.\\d+\\.\\d+$"
    },
    "builder": {
      "type": "string"
    },
    "authoredInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
