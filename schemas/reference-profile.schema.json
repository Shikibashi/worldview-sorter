{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://worldview.edriffles.us/schemas/reference-profile.schema.json",
  "title":"Worldview Sorter independent reference profile",
  "description":"A source-reviewed philosopher or tradition profile mapped to Worldview Sorter propositions without vector similarity or identity assignment.",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","profileVersion","modelVersion","id","label","entityType","origin","coverageStatus","identityOutputAllowed","percentageMatchAllowed","claims","limitations"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "profileVersion":{"type":"string","minLength":1},
    "modelVersion":{"type":"string","minLength":1},
    "id":{"type":"string","minLength":1},
    "label":{"type":"string","minLength":1},
    "entityType":{"enum":["philosopher","tradition"]},
    "origin":{"const":"independent_authoring"},
    "coverageStatus":{"enum":["stub","partial","reviewed"]},
    "identityOutputAllowed":{"const":false},
    "percentageMatchAllowed":{"const":false},
    "claims":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","propositionId","expectedState","importance","evidenceBasis","publicUse","sourceClaims"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "propositionId":{"type":"string","minLength":1},
          "expectedState":{"enum":["supported","opposed"]},
          "importance":{"enum":["core","major","minor"]},
          "evidenceBasis":{"enum":["primary_text","scholarly_reconstruction","editorial_hypothesis"]},
          "publicUse":{"enum":["comparison","context_only"]},
          "sourceClaims":{
            "type":"array","minItems":1,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["sourceId","relationship","claim"],
              "properties":{
                "sourceId":{"type":"string","minLength":1},
                "relationship":{"const":"supports_profile_claim"},
                "claim":{"type":"string","minLength":1}
              }
            }
          },
          "note":{"type":"string"}
        }
      }
    },
    "limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
