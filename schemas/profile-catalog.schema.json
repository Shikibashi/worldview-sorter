{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shikibashi/worldview-sorter/schemas/profile-catalog.schema.json",
  "title": "Worldview Sorter Profile Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "status",
    "identityOutputAllowed",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "catalogVersion": {
      "type": "string"
    },
    "status": {
      "enum": [
        "prototype",
        "calibrated",
        "deprecated"
      ]
    },
    "identityOutputAllowed": {
      "type": "boolean"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "identityLabel",
          "kind",
          "sourceRefs",
          "description",
          "hardGates",
          "softTargets",
          "identityConfirmation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "label": {
            "type": "string"
          },
          "identityLabel": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "hardGates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "probeId",
                    "acceptedValues"
                  ],
                  "properties": {
                    "kind": {
                      "const": "probe"
                    },
                    "probeId": {
                      "type": "string"
                    },
                    "acceptedValues": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "constructId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "construct"
                    },
                    "constructId": {
                      "type": "string"
                    },
                    "min": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "max": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  }
                }
              ]
            }
          },
          "softTargets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "constructId",
                "target",
                "weight"
              ],
              "properties": {
                "constructId": {
                  "type": "string"
                },
                "target": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "identityConfirmation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "prompt",
              "acceptedValues"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "prompt": {
                "type": "string"
              },
              "acceptedValues": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  }
}
