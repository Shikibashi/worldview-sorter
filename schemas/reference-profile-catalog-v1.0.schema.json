{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldview.edriffles.us/schemas/reference-profile-catalog-v1.0.schema.json",
  "title": "Worldview Sorter internal reference-profile catalog",
  "description": "A versioned collection of narrow, source-traceable profile claims tied to exact Worldview Sorter model and route versions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "catalogVersion", "profileModelVersion", "sourceLedgerVersion", "origin", "modelVersion", "routePolicyVersion",
    "publicationStatus", "scopeNote", "sources", "profiles"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "profileModelVersion": { "type": "string", "minLength": 1 },
    "sourceLedgerVersion": { "type": "string", "minLength": 1 },
    "origin": { "const": "independent_authoring" },
    "modelVersion": { "type": "string", "minLength": 1 },
    "routePolicyVersion": { "type": "string", "minLength": 1 },
    "publicationStatus": { "const": "internal_only" },
    "scopeNote": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "reference-profile-v1.1.schema.json" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceType", "authors", "title", "url", "accessNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["primary_text", "signed_scholarly_reference", "peer_reviewed_scholarship", "bibliographic_metadata"] },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "title": { "type": "string", "minLength": 1 },
        "container": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "accessNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
