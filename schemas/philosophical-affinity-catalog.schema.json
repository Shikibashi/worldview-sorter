{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Shikibashi/worldview-sorter/schemas/philosophical-affinity-catalog.schema.json",
  "title":"Philosophical Affinity Catalog",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","catalogVersion","status","modelVersion","instrumentVersion","resultSemanticsVersion","affinitySemanticsVersion","identityOutputAllowed","percentageMatchAllowed","sources","traditions"],
  "properties":{
    "schemaVersion":{"const":"philosophical-affinity-catalog-1"},
    "catalogVersion":{"type":"string","pattern":"^philosophical-affinity-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"const":"theoretical_pilot_comparison_unvalidated"},
    "modelVersion":{"type":"string"},
    "instrumentVersion":{"type":"string"},
    "resultSemanticsVersion":{"type":"string"},
    "affinitySemanticsVersion":{"const":"doctrinal-comparison-1.0.0"},
    "identityOutputAllowed":{"const":false},
    "percentageMatchAllowed":{"const":false},
    "sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},
    "traditions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/tradition"}}
  },
  "$defs":{
    "source":{"type":"object","additionalProperties":false,"required":["id","type","title","url"],"properties":{"id":{"type":"string"},"type":{"enum":["primary","academic_secondary"]},"title":{"type":"string"},"url":{"type":"string","format":"uri"}}},
    "mapping":{"type":"object","additionalProperties":false,"required":["status","note"],"properties":{"status":{"enum":["direct","derived","partial","not_measured","unsuitable"]},"propositionId":{"type":"string"},"expectedState":{"enum":["supported","opposed"]},"note":{"type":"string"}}},
    "commitment":{"type":"object","additionalProperties":false,"required":["id","role","doctrine","sourceIds","mapping"],"properties":{"id":{"type":"string"},"role":{"enum":["defining","characteristic","disputed"]},"doctrine":{"type":"string"},"sourceIds":{"type":"array","minItems":1,"items":{"type":"string"}},"mapping":{"$ref":"#/$defs/mapping"}}},
    "tradition":{"type":"object","additionalProperties":false,"required":["id","name","scope","context","identityClaimAllowed","primarySourceIds","secondarySourceIds","sourceNotes","neighbors","discriminators","nonEntailments","commitments"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"name":{"type":"string"},"scope":{"enum":["comprehensive_system","epistemological_tradition","ethical_theory","metaethical_position","metaphysical_position","political_philosophy"]},"context":{"type":"string"},"identityClaimAllowed":{"const":false},"primarySourceIds":{"type":"array","items":{"type":"string"}},"secondarySourceIds":{"type":"array","minItems":1,"items":{"type":"string"}},"sourceNotes":{"type":"string"},"neighbors":{"type":"array","minItems":1,"items":{"type":"string"}},"discriminators":{"type":"array","minItems":1,"items":{"type":"string"}},"nonEntailments":{"type":"array","minItems":1,"items":{"type":"string"}},"commitments":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/commitment"}}}}
  }
}
