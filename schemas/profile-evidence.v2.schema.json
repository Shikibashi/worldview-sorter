{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shikibashi/worldview-sorter/schemas/profile-evidence.v2.schema.json",
  "$ref": "#/$defs/catalog",
  "$defs": {
    "sourceIds": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "answerSet": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":["number","string"]}},
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["itemId","itemRevision","support","oppose"],
      "properties": {
        "itemId":{"type":"string","pattern":"^[A-Z]{2}I[0-9]{3}$"},
        "itemRevision":{"type":"integer","minimum":1},
        "support":{"$ref":"#/$defs/answerSet"},"oppose":{"$ref":"#/$defs/answerSet"}
      }
    },
    "criterion": {
      "type":"object","additionalProperties":false,
      "required":["id","constructId","expected","essential","minimumIndependentItems","sourceIds","evidence"],
      "properties": {
        "id":{"type":"string"},"constructId":{"type":["string","null"]},
        "expected":{"enum":["endorse","reject","specified_responses"]},
        "essential":{"type":"boolean"},"minimumIndependentItems":{"type":"integer","minimum":2},
        "sourceIds":{"$ref":"#/$defs/sourceIds"},
        "evidence":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/evidence"}}
      }
    },
    "profile": {
      "type":"object","additionalProperties":false,
      "required":["id","label","scope","sourceIds","criteria","limitations"],
      "properties": {
        "id":{"type":"string"},"label":{"type":"string"},"scope":{"type":"string","minLength":1},
        "sourceIds":{"$ref":"#/$defs/sourceIds"},
        "criteria":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/criterion"}},
        "limitations":{"type":"array","items":{"type":"string"}}
      }
    },
    "catalog": {
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","catalogVersion","bankVersion","registryVersion","status","identityOutputAllowed","interpretationAllowed","profiles"],
      "properties": {
        "schemaVersion":{"const":"2.0.0"},"catalogVersion":{"type":"string"},
        "bankVersion":{"type":"string"},"registryVersion":{"type":"string"},
        "status":{"const":"prototype"},"identityOutputAllowed":{"const":false},"interpretationAllowed":{"const":false},
        "profiles":{"type":"array","items":{"$ref":"#/$defs/profile"}}
      }
    },
    "rawResponse": {
      "type":"object","required":["itemId","itemRevision","state","value"],
      "properties": {
        "itemId":{"type":"string"},"itemRevision":{"type":"integer","minimum":1},
        "state":{"enum":["answered","no_view","not_understood","not_applicable"]},
        "value":{"type":["number","string","array","null"]}
      },
      "allOf":[{"if":{"properties":{"state":{"enum":["no_view","not_understood","not_applicable"]}}},"then":{"properties":{"value":{"type":"null"}}}}]
    },
    "input": {
      "type":"object","required":["bankVersion","responses"],
      "properties": {
        "bankVersion":{"type":"string"},
        "responses":{"type":"array","items":{"$ref":"#/$defs/rawResponse"}},
        "selfReportedIdentities":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}}
      },
      "not":{"anyOf":[{"required":["constructEstimates"]},{"required":["probeResponses"]}]}
    },
    "result": {
      "type":"object",
      "required":["schemaVersion","catalogVersion","policyVersion","bankVersion","status","interpretationAllowed","state","selectedProfileId","publicIdentityLabel","percentageMatchAllowed","selfReportedIdentities","candidates"],
      "properties": {
        "schemaVersion":{"const":"2.0.0"},"catalogVersion":{"type":"string"},"policyVersion":{"type":"string"},"bankVersion":{"type":"string"},
        "status":{"const":"prototype_comparison_not_validated"},"interpretationAllowed":{"const":false},
        "state":{"enum":["comparisons_available","insufficient_evidence"]},
        "selectedProfileId":{"type":"null"},"publicIdentityLabel":{"type":"null"},"percentageMatchAllowed":{"const":false},
        "selfReportedIdentities":{"type":"array","items":{"type":"string"}},
        "candidates":{"type":"array","items":{"type":"object","required":["profileId","scope","state","criteria","unresolved","divergences","sourceIds","publicIdentityLabel"]}}
      }
    }
  }
}
