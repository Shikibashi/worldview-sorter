{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldview-sorter.local/schemas/model-change-proposal.schema.json",
  "title": "Worldview Sorter model change proposal 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalId", "title", "author", "objectType", "changeClass", "status", "affectedObjects", "currentBehavior", "proposedBehavior", "rationale", "philosophicalBasis", "sourceClaims", "alternatives", "respondentImpact", "historicalCompatibility", "tests", "review", "release", "implementationRefs"],
  "properties": {
    "schemaVersion": {"const": "model-change-proposal-1"},
    "proposalId": {"type": "string", "pattern": "^MCP-[0-9]{4}-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "objectType": {"enum": ["item", "construct", "proposition", "derived_rule", "tradition", "criterion", "source", "localization", "route", "result_semantics", "research_classification"]},
    "changeClass": {"enum": ["editorial_only", "semantic_clarification", "substantive_revision", "new_object", "deprecation", "split", "merge", "reclassification", "source_correction"]},
    "status": {"enum": ["draft", "under_review", "approved", "released", "rejected", "withdrawn"]},
    "affectedObjects": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"$ref": "#/properties/objectType"}, "id": {"type": "string", "minLength": 1}}}},
    "currentBehavior": {"type": "string", "minLength": 1},
    "proposedBehavior": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "philosophicalBasis": {"type": "object", "additionalProperties": false, "required": ["proposition", "neighboringViews", "nonEntailments", "existingGap", "scholarlyDisagreement"], "properties": {"proposition": {"type": "string"}, "neighboringViews": {"type": "array", "items": {"type": "string"}}, "nonEntailments": {"type": "array", "items": {"type": "string"}}, "existingGap": {"type": "string"}, "scholarlyDisagreement": {"type": "string"}}},
    "sourceClaims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sourceId", "claim", "relationship"], "properties": {"sourceId": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "relationship": {"enum": ["supports", "challenges", "context"]}}}},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "respondentImpact": {"type": "string", "minLength": 1},
    "historicalCompatibility": {"type": "string", "minLength": 1},
    "tests": {"type": "object", "additionalProperties": false, "required": ["required", "paths"], "properties": {"required": {"type": "array", "items": {"type": "string"}}, "paths": {"type": "array", "items": {"type": "string"}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["approvals"], "properties": {"approvals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "reviewer", "at", "note"], "properties": {"role": {"enum": ["philosophical", "measurement", "linguistic", "cultural", "engineering", "privacy"]}, "reviewer": {"type": "string"}, "at": {"type": "string", "format": "date-time"}, "note": {"type": "string"}}}}}},
    "release": {"type": "object", "additionalProperties": false, "required": ["components", "migration"], "properties": {"components": {"type": "array", "items": {"type": "string"}}, "migration": {"type": "string", "minLength": 1}}},
    "implementationRefs": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{
    "if": {"properties": {"objectType": {"enum": ["proposition", "derived_rule", "criterion", "tradition"]}, "changeClass": {"enum": ["semantic_clarification", "substantive_revision", "new_object", "split", "merge", "reclassification", "source_correction"]}}},
    "then": {"properties": {"sourceClaims": {"contains": {"type": "object", "properties": {"relationship": {"const": "supports"}}, "required": ["relationship"]}}}}
  }]
}
